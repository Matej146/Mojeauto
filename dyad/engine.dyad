"short Engine component description"
component Engine
  delay = BlockComponents.Nonlinear.PadeDelay(n = 6, m = 5, delayTime = theta_e) {^delay}
  lag = BlockComponents.Continuous.FirstOrder(T = tau_e) {^lag}
  "Injection-to-torque transport delay"
  structural parameter theta_e::Real(units = "s") = 0.3
  "Manifold-filling time constant"
  parameter tau_e::Real(units = "s") = 0.3
  limiter = BlockComponents.Nonlinear.Limiter(y_max = T_max, y_min = 0) {^limiter}
  "Peak engine torque"
  parameter T_max::Real(units = "N·m") = 150
  torque = RotationalComponents.Sources.TorqueSource() {^torque}
  spline = Dyad.Spline() {^spline}
  support = Dyad.Spline() {^support}
  tau_cmd = Dyad.RealInput() {^tau_cmd}
relations
  connect(delay.y, lag.u) {^id8}
  connect(lag.y, limiter.u) {^id9}
  connect(limiter.y, torque.tau) {^id10}
  connect(torque.spline, spline) {^id11}
  connect(torque.support, support) {^id12}
  connect(delay.u, tau_cmd) {^id13}
