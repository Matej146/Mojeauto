component MappedCarCoast
  "Initial road speed [km/h]"
  parameter speed_kmh::Real = 90

  "Pedal before release"
  parameter pedal_cmd::Real = 0.0916

  "Initial engine speed [rpm]"
  parameter rpm0::Real = 2182

  "Initial manifold pressure [Pa]"
  parameter p_m0::Pressure = 54420

  pedal = BlockComponents.Sources.Step(
    height = -pedal_cmd,
    offset = pedal_cmd,
    start_time = 5
  )

  brake_cmd = BlockComponents.Sources.Step(
    height = 4000,
    start_time = 5
  )

  car = MappedCar(
    ratio_initial = rpm0 * pi / 30 * 0.31 / (speed_kmh / 3.6)
  )

relations
  connect(pedal.y, car.pedal)
  connect(brake_cmd.y, car.F_brake)

  initial car.body.mass.s = 0
  initial car.body.mass.v = speed_kmh / 3.6
  initial car.flywheel.w = rpm0 * pi / 30
  initial car.flywheel.phi = 0
  initial car.driveline.clutch.spline_b.phi = 0
  initial car.engine.air.manifold.p = p_m0
end

analysis MappedCarCoastTransient
  extends TransientAnalysis(stop = 100)

  parameter speed_kmh::Real = 90
  parameter pedal_cmd::Real = 0.0916
  parameter rpm0::Real = 2182
  parameter p_m0::Pressure = 54420

  model = MappedCarCoast(
    speed_kmh = speed_kmh,
    pedal_cmd = pedal_cmd,
    rpm0 = rpm0,
    p_m0 = p_m0
  )
end