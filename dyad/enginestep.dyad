"short EngineStep component description"
component EngineStep
  engine = Mojeauto.Engine() {^engine}
  cmd = BlockComponents.Sources.Step(height = 200, start_time = 0.5) {^cmd}
  load = RotationalComponents.Components.Inertia(J = 1) {^load}
  mounts = RotationalComponents.Components.Fixed() {^mounts}
relations
  connect(engine.tau_cmd, cmd.y) {^id5}
  connect(engine.spline, load.spline_a) {^id6}
  connect(engine.support, mounts.spline) {^id7}
  initial engine.lag.x = 0
  initial load.phi = 0
  initial load.w = 0
metadata {
  "Dyad": {
    "experiments": {},
    "tests": {},
    "labels": [
      {
        "label": "$(instance)",
        "x": 500,
        "y": 1100,
        "rot": 0,
        "layer": "icon",
        "attrs": {}
      }
    ],
    "icons": {"default": "dyad://Dyad/Default.svg"},
    "path": {},
    "doc": {"behavior": true},
    "deprecated": null,
    "panel": {}
  },
  "_links": {
    "engine": {
      "Dyad": {"placement": {"diagram": {"x1": 450, "x2": 550, "y1": 240, "y2": 340}}}
    },
    "cmd": {
